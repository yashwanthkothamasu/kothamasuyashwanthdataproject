							"value": "@dataset().p_file_name",
							"type": "Expression"
						},
						"folderPath": "onpremise",
						"fileSystem": "bronze"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
