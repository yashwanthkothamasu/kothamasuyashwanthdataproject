								"referenceName": "ls_datalake",
								"type": "LinkedServiceReference"
							},
							"name": "sink6"
						}
					],
					"transformations": [
						{
							"name": "countryupper"
						},
						{
							"name": "select1"
						},
						{
							"name": "filter1"
						},
						{
